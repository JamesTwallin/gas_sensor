# What EAS Build uploads. This replaces .gitignore for the upload, so it must
# repeat the important exclusions. Native folders are generated on the build
# server from app.json (CNG); a local one would be used verbatim, and a Gradle
# build in it holds locks that make the upload fail.
node_modules/
/android
/ios
.expo/
dist/
web-build/
coverage/
*.log
*.jks
credentials.json
.DS_Store
