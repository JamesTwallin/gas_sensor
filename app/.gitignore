node_modules/
coverage/
*.log

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `npx expo prebuild` (CNG) and are not tracked.
# Everything they need is in app.json; EAS Build runs prebuild itself.
/android
/ios

# EAS / credentials
.easignore
credentials.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# macOS / editors
.DS_Store
*.tsbuildinfo

# The repo root ignores *.png (generated plots); the app icons and splash screen
# are source and must be tracked.
!assets/**/*.png
