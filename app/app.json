{
  "expo": {
    "name": "GasSnifferBuddy",
    "slug": "ch4-survey",
    "version": "0.1.0",
    "scheme": "sensorbuddy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inorite.sensorbuddy",
      "infoPlist": {
        "NSBluetoothPeripheralUsageDescription": "GasSnifferBuddy talks to your methane sensor board over Bluetooth Low Energy.",
        "NSLocationWhenInUseUsageDescription": "GasSnifferBuddy tags each reading with your position so a survey can be plotted on a map.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.inorite.sensorbuddy",
      "adaptiveIcon": {
        "backgroundColor": "#111110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSingleLocationPermission",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "GasSnifferBuddy talks to your methane sensor board over Bluetooth Low Energy."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GasSnifferBuddy tags each reading with your position so a survey can be plotted on a map.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-dev-client",
      "expo-sharing",
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "owner": "inorite-ltd",
    "extra": {
      "eas": {
        "projectId": "a334d071-5624-4d42-a956-9685b8bb5a93"
      }
    }
  }
}
